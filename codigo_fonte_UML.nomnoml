#direction: down
#spacing: 75
#padding: 16
#edges: rounded

[<abstract> Pessoa |
  +nome: string;
  +idade: int;
  -_cpf: string
|
  +get_cpf(): string
]

[<abstract> Paciente |
  -_sintomas: string;
  -_eh_retorno: bool
|
  +is_retorno(): bool;
  +get_prioridade_faixa_etaria(): tuple;
  +gerar_conta(): float
]

[Medico |
  -_crm: string;
  +espec: string
|
  +atender(): string
]

[PacienteParticular |
  -_valor_consulta: float
|
  +gerar_conta(): float
]

[PacienteConvenio |
  -_nomePlano: string;
  -_numeroCarteirinha: string
|
  +gerar_conta(): float
]

[Prontuario |
  -_historico_consultas: List<Consulta>
|
  +adicionar_consulta(consulta: Consulta);
  +obter_historico(): List<Consulta>;
  +exibir_prontuario_texto(): string
]

[Consulta |
  -_data_hora: datetime;
  -_diagnostico: string;
  -_receita: string
|
  +obter_resumo_texto(): string
]

[Triagem |
  -_temperatura: float;
  -_pressaoSistolica: int;
  -_nivel_dor: int;
  -_cor_risco: string;
  -_peso_prioridade: int
|
  +calcular_risco();
  +exibir_triagem(): string
]

[ItemFila |
  -_contador_chegada: int (static);
  +ordem_chegada: int;
  +data_hora_chegada: datetime;
  +desc_idade: string;
  +chave_prioridade: tuple
|
  +calcular_tempo_estimado(posicao_fila: int): tuple
]

[FilaConsultas |
  -_fila: List<ItemFila>
|
  +enfileirar(paciente: Paciente, triagem: Triagem): ItemFila;
  -_ordenar();
  +desenfileirar(): ItemFila;
  +proximo(): ItemFila;
  +esta_vazia(): bool;
  +tamanho(): int;
  +obter_lista(): list
]

// ------------------------------------------------
// RELACIONAMENTOS E ESTRUTURAÇÃO VISUAL
// ------------------------------------------------

// 1. Árvore de Herança (Agrupa as pessoas à esquerda/centro)
[Pessoa] <:- [Medico]
[Pessoa] <:- [<abstract> Paciente]
[<abstract> Paciente] <:- [PacienteParticular]
[<abstract> Paciente] <:- [PacienteConvenio]

// 2. Fila e Triagem (Agrupa as regras de chegada à direita)
[FilaConsultas] o-> [ItemFila]
[ItemFila] -> [Triagem]
[ItemFila] -> [<abstract> Paciente]

// 3. Prontuário e Consulta (O fluxo de atendimento no centro/baixo)
[<abstract> Paciente] +-> [Prontuario]
[Prontuario] o-> [Consulta]

// 4. Dependências da Consulta (Deixando claro de onde ela puxa dados)
[Consulta] -> [<abstract> Paciente]
[Consulta] -> [Medico]
[Consulta] -> [Triagem]